{
  "name": "astronomy-shop-qa-automation",
  "private": true,
  "description": "API and UI automation for the OpenTelemetry Astronomy Shop",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --config allurerc.mjs --clean",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit",
    "lint:pom": "node scripts/check-pom.mjs",
    "check": "npm run typecheck && npm run lint:pom"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure": "^3.21.0",
    "allure-playwright": "^3.13.0",
    "typescript": "^7.0.2"
  }
}
